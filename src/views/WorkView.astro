---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import LivePreview from '../components/LivePreview.astro';
import { ui, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<Base lang={lang} page="work" title={t.meta.work.title} description={t.meta.work.description}>
  <section class="page-head wrap">
    <div class="label">{t.workLabel}</div>
    <h1 data-hero-fade>{t.workTitle}</h1>
    <p class="lede" data-hero-fade>{t.workPageLede}</p>
  </section>

  <div class="wrap cases">
    {projects.map((project, i) => {
      const p = t.projects[project.key];
      const building = project.kind === 'progress';
      return (
        <article class="case" data-reveal>
          <LivePreview lang={lang} project={project} big eager={i === 0} />
          <div class="case-info">
            <span class="case-num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{project.name}</h2>
            <dl class="facts">
              <div><dt>{t.typeLabel}</dt><dd>{building ? t.kinds.progress : t.kinds[project.kind]}</dd></div>
              <div><dt>{t.statusLabel}</dt><dd class:list={['state', { progress: building }]}><i></i>{building ? t.statusProgress : t.statusDone}</dd></div>
            </dl>
            <p>{building ? p.text : `${p.niche}. ${p.text}`}</p>
            <h3>{t.handledTitle}</h3>
            <ul class="checks">{p.handled.map((h) => <li>{h}</li>)}</ul>
            <a class="btn solid" href={project.url} target="_blank" rel="noopener">{t.visit} <span class="arrow" aria-hidden="true">↗</span></a>
          </div>
        </article>
      );
    })}
  </div>

  <CtaBand lang={lang} />
</Base>
