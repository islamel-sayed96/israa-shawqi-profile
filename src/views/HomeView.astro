---
import Base from '../layouts/Base.astro';
import StoreDash from '../components/StoreDash.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/Contact.astro';
import { ui, path, asset, type Lang } from '../i18n/ui';
import { site, marqueeA, marqueeB, platformCount } from '../data/site';
import { projects, storeCount } from '../data/projects';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const building = projects.filter((p) => p.kind === 'progress');
const done = projects.filter((p) => p.kind !== 'progress');
// Six-column grid: in-progress projects take half a row; the rest take a third,
// and a short last row stretches so it doesn't leave a gap.
const rem = done.length % 3;
const wideFrom = rem === 0 ? done.length : done.length - rem;
---
<Base lang={lang} page="" title={t.meta.home.title} description={t.meta.home.description}>
  <link slot="head" rel="preload" as="image" href={asset('israa-260.webp')} type="image/webp" fetchpriority="high" />

  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-left">
      <div class="hero-inner">
        <span class="tag" data-hero-fade>{t.tag}</span>
        <div class="avatar" data-hero-fade>
          <img src={asset('israa-260.webp')} alt={site.fullName} width="130" height="130" fetchpriority="high" decoding="async" />
          <span class="status" title={t.available}></span>
        </div>
        <h1 class="hero-name" id="hero-h" data-hero-name>
          <span class="line"><span>{t.name[0]}</span></span>
          <span class="line"><em><span>{t.name[1]}</span></em></span>
        </h1>
        <p class="hero-desc" data-hero-fade>{t.heroLede}</p>
        <div class="hero-btns" data-hero-fade>
          <a class="btn light" href={site.whatsapp} target="_blank" rel="noopener">{t.ctaWhatsapp} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn outline" href={`mailto:${site.email}`}>{t.ctaEmail}</a>
        </div>
      </div>
    </div>
    <div class="hero-right">
      <StoreDash lang={lang} />
    </div>
  </section>

  <section class="band" aria-label={t.toolsLabel}>
    <div class="wrap stats">
      <div class="stat" data-reveal><b><span data-count={storeCount}>{storeCount}</span>+</b><span>{t.stats.stores}</span></div>
      <div class="stat" data-reveal><b><span data-count={projects.length}>{projects.length}</span></b><span>{t.stats.projects}</span></div>
      <div class="stat" data-reveal><b><span data-count={platformCount}>{platformCount}</span></b><span>{t.stats.platforms}</span></div>
      <div class="stat" data-reveal><b>{t.basedValue}</b><span>{t.stats.based}</span></div>
    </div>
    <div class="marquee">
      <span class="marquee-label">{t.toolsLabel}</span>
      <div class="marquee-rows">
        {[marqueeA, marqueeB].map((row, r) => (
          <div class="marquee-viewport">
            <div class:list={['marquee-track', { reverse: r === 1 }]}>
              {[...row, ...row].map((tool, i) => <span class="tool-chip" aria-hidden={i >= row.length ? 'true' : undefined}>{tool}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap" id="services" aria-labelledby="svc-h">
    <div class="sec-head split light">
      <div>
        <div class="label">{t.servicesLabel}</div>
        <h2 id="svc-h">{t.servicesTitle}</h2>
      </div>
      <p>{t.servicesLede}</p>
    </div>
    <div class="services">
      {t.services.map((s, i) => (
        <div class:list={['svc', { focus: i === 0 }]} data-reveal>
          <span class="svc-num">0{i + 1}</span>
          {i === 0 && <span class="focus-badge">★ {t.focus}</span>}
          <span class="svc-icon"><Icon name={s.icon} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <div class="svc-tags">{s.tags.map((tag) => <span>{tag}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section dark-section" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="sec-head split">
        <div>
          <div class="label">{t.workLabel}</div>
          <h2 id="work-h">{t.workTitle}</h2>
        </div>
        <p>{t.workLede}</p>
      </div>
      <div class="projects">
        {building.map((p) => <ProjectCard lang={lang} project={p} wide />)}
        {done.map((p, i) => <ProjectCard lang={lang} project={p} wide={i >= wideFrom} />)}
      </div>
      <div class="sec-foot"><a class="btn outline" href={path(lang, 'work')}>{t.seeAllWork} <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="process-h">
    <div class="sec-head">
      <div class="label">{t.processLabel}</div>
      <h2 id="process-h">{t.processTitle}</h2>
    </div>
    <ol class="process" data-process>
      {t.process.map((p, i) => (
        <li data-reveal>
          <span class="step">{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <Contact lang={lang} />
</Base>
