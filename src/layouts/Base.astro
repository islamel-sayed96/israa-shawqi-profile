---
import '../styles/global.css';
import { ui, path, asset, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  page: '' | 'work' | 'about' | '404';
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const pageKey = page === '404' ? '' : page;
const origin = Astro.site ? Astro.site.origin : '';
const canonical = origin + path(lang, pageKey);
const ogImage = origin + asset(lang === 'ar' ? 'og-ar.png' : 'og.png');
const navItems = [
  { key: 'work', href: path(lang, 'work'), label: t.nav.work },
  { key: 'services', href: `${path(lang)}#services`, label: t.nav.services },
  { key: 'about', href: path(lang, 'about'), label: t.nav.about },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}${path('en')}#israa`,
      name: site.fullName,
      jobTitle: 'E-commerce Store Manager',
      email: `mailto:${site.email}`,
      telephone: site.phoneHref,
      url: origin + path('en'),
      image: origin + asset('israa.jpg'),
      address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
      knowsAbout: ['Shopify', 'Salla', 'Wix', 'WordPress', 'Amazon Seller Central', 'Meta Ads', 'Payment gateways', 'E-commerce operations', 'Product management', 'Order fulfillment'],
    },
    {
      '@type': 'ProfessionalService',
      name: `${site.fullName} — E-commerce Store Management`,
      url: origin + path('en'),
      image: ogImage,
      telephone: site.phoneHref,
      email: site.email,
      areaServed: ['Dubai', 'United Arab Emirates'],
      address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
      founder: { '@id': `${origin}${path('en')}#israa` },
    },
  ],
};
---
<!doctype html>
<html lang={lang} dir={t.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {origin && <link rel="canonical" href={canonical} />}
  {page !== '404' && <link rel="alternate" hreflang="en" href={origin + path('en', pageKey)} />}
  {page !== '404' && <link rel="alternate" hreflang="ar" href={origin + path('ar', pageKey)} />}
  {page !== '404' && <link rel="alternate" hreflang="x-default" href={origin + path('en', pageKey)} />}
  {origin && <link rel="sitemap" href={asset('sitemap-index.xml')} />}
  {page === '404' && <meta name="robots" content="noindex" />}
  <meta name="author" content={site.fullName} />
  <meta name="theme-color" content="#2d6a4f" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {origin && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ar_AE'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href={asset('favicon.ico')} sizes="any" />
  <link rel="icon" href={asset('favicon-96x96.png')} sizes="96x96" type="image/png" />
  <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
  <link rel="manifest" href={asset('site.webmanifest')} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={lang === 'ar'
    ? 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@400;500;700&family=Amiri:wght@700&family=IBM+Plex+Sans+Arabic:wght@400;500;700&display=swap'
    : 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@400;500;700&display=swap'} />

  <script is:inline>
    try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={path(lang)} aria-label={site.brand}>
        <span class="logo-mark" aria-hidden="true">IS</span>
        <span class="logo-name">Israa <em>Shawqi</em></span>
      </a>
      <nav class="nav" id="nav" aria-label="Main">
        {navItems.map((n) => (
          <a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="nav-cta" href={`${path(lang)}#contact`}>{t.nav.contact}</a>
      </nav>
      <div class="tools">
        <a class="tool lang" href={path(other, pageKey)} hreflang={other} lang={other}>{t.langSwitch}</a>
        <button class="tool" type="button" data-theme-toggle aria-label={t.themeDark} data-label-dark={t.themeDark} data-label-light={t.themeLight}>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
          <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="tool menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          <span class="visually-hidden">{t.menu}</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-top">
      <a class="footer-name" href={path(lang)}>Israa <em>Shawqi</em></a>
      <div class="footer-contact">
        <a href={site.whatsapp} target="_blank" rel="noopener" dir="ltr">{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <span>© {new Date().getFullYear()} · {t.footerRole}</span>
    </div>
  </footer>

  <script>
    import '../scripts/main';
  </script>
</body>
</html>
