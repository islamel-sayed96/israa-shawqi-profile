---
import { ui, path, type Lang } from '../i18n/ui';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<section class="cta-band" aria-labelledby="cta-h">
  <div class="wrap cta-inner" data-reveal>
    <div>
      <h2 id="cta-h">{t.ctaBandTitle}</h2>
      <p>{t.ctaBandText}</p>
    </div>
    <div class="hero-btns">
      <a class="btn light" href={site.whatsapp} target="_blank" rel="noopener">{t.ctaWhatsapp} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn outline" href={`${path(lang)}#contact`}>{t.nav.contact}</a>
    </div>
  </div>
</section>
