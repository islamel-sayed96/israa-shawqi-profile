---
// Contact section: channels with copy buttons, the "why me" list and a small form
// that opens WhatsApp with a ready-made message (no server needed).
import { ui, type Lang } from '../i18n/ui';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const f = t.form;
---
<section class="section contact" id="contact" aria-labelledby="contact-h">
  <div class="wrap contact-grid">
    <div>
      <div class="label">{t.contactLabel}</div>
      <h2 class="big-title" id="contact-h" data-reveal>{t.contactTitle[0]}<br /><em>{t.contactTitle[1]}</em></h2>
      <p class="lede">{t.contactLede}</p>
      <div class="channels">
        <div class="channel">
          <span class="ch-icon wa" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.2-.2-.5-.3Z"/></svg>
          </span>
          <span class="ch-text"><small>{t.whatsapp}</small><a href={site.whatsapp} target="_blank" rel="noopener" dir="ltr">{site.phone}</a></span>
          <button class="copy" type="button" data-copy={site.phone} data-done={t.copied}>{t.copy}</button>
        </div>
        <div class="channel">
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </span>
          <span class="ch-text"><small>{t.email}</small><a href={`mailto:${site.email}`}>{site.email}</a></span>
          <button class="copy" type="button" data-copy={site.email} data-done={t.copied}>{t.copy}</button>
        </div>
      </div>
      <div class="why" data-reveal>
        <h3>{t.whyTitle}</h3>
        <ul>{t.why.map((w) => <li>{w}</li>)}</ul>
      </div>
    </div>

    <form class="brief" data-brief data-reveal
      data-wa={site.phoneHref.replace('+', '')}
      data-greeting={f.greeting} data-l-name={f.fromLabel} data-l-store={f.storeLabel} data-l-need={f.needLabel}>
      <div class="brief-head">
        <span class="brief-avatar" aria-hidden="true">IS</span>
        <div><h3>{f.title}</h3><span class="online"><i></i>{t.available}</span></div>
      </div>
      <label>{f.name}<input name="name" autocomplete="name" placeholder={f.namePh} /></label>
      <label>{f.store}<input name="store" autocomplete="url" placeholder={f.storePh} dir="ltr" /></label>
      <fieldset>
        <legend>{f.need}</legend>
        <div class="chips">
          {t.services.map((s) => (
            <label class="chip"><input type="checkbox" name="need" value={s.title} /><span>{s.title}</span></label>
          ))}
        </div>
      </fieldset>
      <label>{f.message}<textarea name="message" rows="3" placeholder={f.messagePh}></textarea></label>
      <button class="btn solid wide" type="submit">{f.send} <span class="arrow" aria-hidden="true">→</span></button>
    </form>
  </div>
</section>
