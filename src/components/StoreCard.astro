---
// A store screenshot inside a browser window, with its niche, summary and tags.
import { ui, asset, type Lang } from '../i18n/ui';
import type { stores } from '../data/stores';
type Store = (typeof stores)[number];
const { lang, store, index } = Astro.props as { lang: Lang; store: Store; index: number };
const t = ui[lang];
const s = t.stores[store.key];
---
<article class="store-card" data-reveal>
  <a class="browser" href={store.url} target="_blank" rel="noopener" aria-label={`${t.visit}: ${store.name}`} data-tilt>
    <span class="browser-bar" dir="ltr">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="url"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{store.domain}</span>
    </span>
    <span class="browser-view">
      <img
        src={asset(`work/${store.image}-800.webp`)}
        srcset={`${asset(`work/${store.image}-800.webp`)} 800w, ${asset(`work/${store.image}-1400.webp`)} 1400w`}
        sizes="(max-width: 900px) 92vw, 420px"
        alt={`${store.name} — ${s.niche}`}
        width="800" height="450" loading="lazy" decoding="async" />
    </span>
  </a>
  <div class="store-info">
    <span class="eyebrow">0{index + 1} · {s.niche} · {t.market}</span>
    <h3>{store.name}</h3>
    <p>{s.text}</p>
    <div class="ptags">{s.tags.map((tag) => <span>{tag}</span>)}</div>
    <a class="link" href={store.url} target="_blank" rel="noopener">{t.visit} <span class="arrow" aria-hidden="true">↗</span></a>
  </div>
</article>
